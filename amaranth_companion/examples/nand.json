      "text": "async def testbench(ctx, dut):\n    for a, b in ((0b1100, 0b1010), (0b1111, 0b1111), (0, 0)):\n        ctx.set(dut.a_in, a)\n        ctx.set(dut.b_in, b)\n        await ctx.delay(1e-6)\n        assert ctx.get(dut.q_out) == ~(a & b) & 0b1111\n",
