    "n0005": {
      "title": "Masker",
      "pos": [
        -340.0,
        -280.0
      ],
      "text": "from amaranth import *\n\n\nclass Masker(Elaboratable):\n    \"\"\"Pass `data_in` through when selected, otherwise zero.\n\n    `width_param` is wired from the variable block: change it and every\n    port on this block, and on the design around it, resizes.\n    \"\"\"\n\n    def __init__(self, width_param=1):\n        self.data_in = Signal(width_param)\n        self.select_in = Signal(1)\n        self.data_out = Signal(width_param)\n\n    def elaborate(self, platform):\n        m = Module()\n        with m.If(self.select_in):\n            m.d.comb += self.data_out.eq(self.data_in)\n        with m.Else():\n            m.d.comb += self.data_out.eq(0)\n        return m\n",
      "kind": "code",
      "ports": [
        {
          "name": "width_param",
          "role": "param",
          "default": 1
        },
        {
          "name": "data_in",
          "role": "in",
          "shape": {
            "width": 8,
            "signed": false
          }
        },
        {
          "name": "select_in",
          "role": "in",
          "shape": {
            "width": 1,
            "signed": false
          }
        },
        {
          "name": "data_out",
          "role": "out",
          "shape": {
            "width": 8,
            "signed": false
          }
        }
      ],
      "block_id": "builtin.code"
    },
    "n0006": {
      "title": "Masking",
      "pos": [
        -340.0,
        240.0
      ],
      "text": "async def testbench(ctx, dut):\n    ctx.set(dut.data_in, 0xA5)\n    ctx.set(dut.select_in, 1)\n    await ctx.delay(1e-6)\n    assert ctx.get(dut.data_out) == 0xA5\n\n    ctx.set(dut.select_in, 0)\n    await ctx.delay(1e-6)\n    assert ctx.get(dut.data_out) == 0\n",
      "kind": "testbench",
      "ports": [],
